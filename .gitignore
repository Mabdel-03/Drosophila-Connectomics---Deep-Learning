# ---- Bulk data: lives on scratch, never in git ----
*.feather
*.parquet
*.npz
*.npy
*.pt
*.feather.part
data/
results/
reports/data_card_*.md

# The browser simulator ships small, prepared model inputs rather than bulk data.
!fly_fgs_source/data/
!fly_fgs_source/data/*.json

# Allow small committable reports if explicitly forced with `git add -f`.
# (The canonical data card is regenerated on scratch; commit a copy only when desired.)

# ---- SLURM ----
slurm/logs/
slurm-*.out
*.out

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
*.egg

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store

# ---- Local secrets / overrides ----
.env
*.local
.cave_secret              # CAVE API token (stage 5 live queries)
cave_cache/               # any stray cache outside scratch (canonical lives on FLYCONN_DATA_ROOT)
.flyconn_cache/           # live-API caches (synapses, skeletons) — project tree, off scratch (FLYCONN_CACHE_ROOT)
