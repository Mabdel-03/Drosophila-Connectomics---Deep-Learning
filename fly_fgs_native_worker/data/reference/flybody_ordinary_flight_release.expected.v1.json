  "original_inference_sequence": [
    {
      "operation": "flybody.fly_envs.flight_imitation(ref_path=reference_dataset, wpg_pattern_path=wpg, terminal_com_dist=float('inf'))",
      "stage_id": "construct_environment"
    },
    {
      "operation": "dm_env_wrappers.SinglePrecisionWrapper(environment)",
      "stage_id": "single_precision_wrapper"
    },
    {
      "operation": "dm_env_wrappers.CanonicalSpecWrapper(environment, clip=True)",
      "stage_id": "canonical_action_wrapper"
    },
    {
      "operation": "tf.saved_model.load(policy_root)",
      "stage_id": "load_saved_model"
    },
    {
      "operation": "flybody.agents.utils_tf.TestPolicyWrapper(policy, sample=False)",
      "stage_id": "mean_policy_wrapper"
    },
    {
      "operation": "timestep = environment.reset()",
      "stage_id": "reset_environment"
    },
    {
      "operation": "action = policy(timestep.observation)",
      "stage_id": "infer_distribution_mean_action"
    },
    {
      "operation": "timestep = environment.step(action)",
      "stage_id": "step_environment"
    }
  ],
